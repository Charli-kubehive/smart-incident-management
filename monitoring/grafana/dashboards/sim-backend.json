{
  "title": "SIM Backend",
  "uid": "sim-backend",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Backend up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "up{job=\"sim-backend\"}", "refId": "A" } ]
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP requests / sec",
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count{job=\"sim-backend\"}[1m]))", "legendFormat": "req/s", "refId": "A" } ]
    },
    {
      "id": 3, "type": "timeseries", "title": "JVM heap used (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(jvm_memory_used_bytes{job=\"sim-backend\",area=\"heap\"})", "legendFormat": "heap", "refId": "A" } ]
    },
    {
      "id": 4, "type": "timeseries", "title": "CPU usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "process_cpu_usage{job=\"sim-backend\"}", "legendFormat": "cpu", "refId": "A" } ]
    }
  ]
}
